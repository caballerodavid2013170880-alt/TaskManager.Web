<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/lux/bootstrap.min.css" rel="stylesheet">  
@model TaskManager.Web.Models.TaskSearchViewModel

@{
    ViewData["Title"] = "Tareas";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- <partial name="_AlertMessages" /> //Duplicación de alerta -->


<h1>Tareas</h1>

@if (Model?.Result?.Items != null)
{
    <p>Mostrando @Model.Result.Items.Count() de @Model.Result.TotalCount</p>  }

<div class="container mt-4">
    <form asp-action="Index" method="get" class="mb-4">
        <div class="row">
            <div class="col-3">
                <label>Texto</label>
                <input type="text" class="form-control" name="Text" value="@Model?.Text" />
            </div>

            <div class="col-3">
                <label>Categoría</label>
                <input type="text" class="form-control" name="CategoryName" value="@Model?.CategoryName" />
            </div>

            <div class="col-2">
                <label>Completado</label>
                <select name="IsCompleted" class="form-control">
                    <option value="">--Todos--</option>
                    <option value="true" selected="@(Model?.IsCompleted == true ? "selected" : null)">Sí</option>
                    <option value="false" selected="@(Model?.IsCompleted == false ? "selected" : null)">No</option>
                </select>
            </div>

            <div class="col-2">
                <label>Step</label>
                <input type="number" class="form-control" name="Step" value="@Model?.Step" />
            </div>

            <div class="col-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </div>
    </form>
</div> @if (Model?.Result?.Items == null || !Model.Result.Items.Any())
{
    <p>No se encontraron resultados.</p>
}
else
{
    <p>Mostrando @Model.Result.Items.Count() de @Model.Result.TotalCount resultados.</p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Completado</th>
                    <th>Step</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Result.Items)
                {
                    <tr>
                        <td>@t.Title</td>
                        <td>@t.CategoryName</td>
                        <td>@(t.IsCompleted ? "Sí" : "No")</td>
                        <td>@t.Step</td>
                        <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">
                                Ver detalles
                            </a>

                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Editar</a>

                            @if (t.IsCompleted)
                            {
                                <button class="btn btn-secondary btn-sm" disabled>Eliminar</button>
                            }
                            else
                            {
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('¿Eliminar?');">
                                        Eliminar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

@{
    var totalCount = Model?.Result?.TotalCount ?? 0;
    var pageSize = Model?.PageSize ?? 10;
    var currentPage = Model?.Page ?? 1;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);

    // Lógica para limitar a 10 páginas visibles (ventana actual)
    int maxVisiblePages = 10;
    int startPage = Math.Max(1, currentPage - (maxVisiblePages / 2));
    int endPage = Math.Min(totalPages, startPage + maxVisiblePages - 1);

    if (endPage - startPage + 1 < maxVisiblePages)
    {
        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
    }

    // Lógica para saltos de decenas
    int currentDecade = (int)(Math.Floor((double)(currentPage - 1) / 10) * 10);
}

@if (totalPages > 1)
{
    <nav aria-label="Navegación de tareas" class="d-flex justify-content-center mt-4">
        <ul class="pagination flex-wrap shadow-sm">

            @for (int d = 30; d >= 10; d -= 10)
            {
                int targetDecade = currentDecade - (d - 10);
                // Ajuste para que muestre la decena anterior exacta
                if (targetDecade < currentDecade && targetDecade >= 1)
                {
                    <li class="page-item d-none d-md-block">
                        <a class="page-link bg-light text-muted" asp-action="Index" asp-route-page="@targetDecade" asp-route-pageSize="@pageSize">@targetDecade</a>
                    </li>
                }
            }

            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>

            @for (int d = 10; d <= 30; d += 10)
            {
                int nextBaseDecade = ((int)Math.Floor((double)(currentPage - 1) / 10) * 10) + 10 + d;

                if (nextBaseDecade <= totalPages)
                {
                    <li class="page-item d-none d-md-block">
                        <a class="page-link bg-light text-muted" asp-action="Index" asp-route-page="@nextBaseDecade" asp-route-pageSize="@pageSize">@nextBaseDecade</a>
                    </li>
                }
            }
        </ul>
    </nav>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> ```
