@model TaskManager.Web.Models.CreateTaskViewModel

@{
    ViewData["Title"] = "Crear tarea";
}

<partial name="_AlertMessages" />
<h1>Crear tarea</h1>

<form asp-action="Create" method="post">
    @* Mapeo manual para la parcial *@
    <partial name="_TaskFormPartial"
             model='new TaskManager.Web.Models.TaskViewModel { Title = Model.Title, CategoryId = Model.CategoryId, Step = Model.Step }'
             view-data='@new ViewDataDictionary(ViewData) { { "IsEdit", false } }' />

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}