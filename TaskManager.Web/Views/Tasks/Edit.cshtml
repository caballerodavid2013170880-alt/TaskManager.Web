@model TaskManager.Web.Models.EditTaskViewModel

@{
    ViewData["Title"] = "Editar tarea";
}

<h1>Editar tarea</h1>

<form asp-action="Edit" method="post">
    <partial name="_TaskFormPartial"
             model='new TaskManager.Web.Models.TaskViewModel { Id = Model.Id, Title = Model.Title, CategoryId = Model.CategoryId, Step = Model.Step, IsCompleted = Model.IsCompleted }'
             view-data='@new ViewDataDictionary(ViewData) { { "IsEdit", true } }' />

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}