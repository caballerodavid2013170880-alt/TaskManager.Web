@model TaskManager.Web.Models.TaskFormViewModel

<div class="modal-header">
    <h5 class="modal-title">
        @(Model.Id == 0 ? "Crear tarea" : "Editar tarea")
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form id="taskForm">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Título</label>
            <input name="Title" value="@Model.Title" class="form-control" />
            <span class="text-danger" data-valmsg-for="Title"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Categoría</label>

            <select id="categorySelect"
                    name="CategoryId"
                    class="form-select"
                    data-selected-category-id="@Model.CategoryId">
                <option value="">-- Seleccione una categoría --</option>
                @* Las opciones reales se llenarán con fetch *@
            </select>

            <span class="text-danger" data-valmsg-for="CategoryId"></span>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Step</label>
            <input name="Step" value="@Model.Step" type="number" class="form-control" />
            <span class="text-danger" data-valmsg-for="Step"></span>
        </div>

        <div class="mb-3 form-check">
        <input class="form-check-input" type="checkbox" name="IsCompleted" id="chkIsCompleted" @(Model.IsCompleted ? "checked" : "")>
        <label class="form-check-label" for="chkIsCompleted">
            ¿Tarea completada?
        </label>
</div>
    </form>
</div>

<div class="modal-footer">
    <button id="btnSaveTask" class="btn btn-primary">
        Guardar
    </button>
</div>